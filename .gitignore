# Databases: generated by src/generate_data.py and src/inject_faults.py
# (fixed seed, so anyone can rebuild them)
data/*.duckdb
data/scenarios/*.duckdb
*.duckdb.wal
data/*.sqlite

# Answer-key CSVs regenerated by src/generate_data.py.
# Scores in data/truth/scores/ stay tracked: the README cites them as evidence.
data/truth/*.csv

# Saved model files (about 116 MB each, rebuildable by fitting)
models/
*.nc

# Python and notebooks
.venv/
__pycache__/
*.pyc
.ipynb_checkpoints/
