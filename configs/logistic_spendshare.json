{
  "name": "logistic_spendshare",
  "description": "Candidate B. Logistic saturation (2 parameters per channel). Positive intercept, beta prior scaled to spend share.",
  "channels": [
    "meta",
    "google",
    "tiktok",
    "email"
  ],
  "adstock_l_max": 8,
  "saturation": "logistic",
  "yearly_seasonality": 2,
  "controls": [
    "hol_black_friday",
    "hol_cyber_monday",
    "hol_mothers_day",
    "hol_valentines",
    "hol_christmas",
    "promo_intensity",
    "trend"
  ],
  "spend_share_scale": 0.15,
  "beta_floor_roas_95": {"email": 15},
  "priors": {
    "intercept": {
      "dist": "HalfNormal",
      "sigma": 1
    },
    "saturation_beta": {
      "dist": "HalfNormal",
      "sigma": "spend_share"
    }
  },
  "sampler": {
    "draws": 1000,
    "tune": 1000,
    "chains": 4,
    "target_accept": 0.9,
    "random_seed": 42
  }
}
